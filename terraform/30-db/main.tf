# Credentials are generated by Terraform and stored in AWS Secrets Manager;
# nothing sensitive is committed to Git or typed by hand.
resource "random_password" "admin" {
  length  = 32
  special = false # alphanumeric only: safe to embed in SQL files and connection strings
}

resource "random_password" "app" {
  length  = 32
  special = false
}

module "db" {
  source  = "terraform-aws-modules/rds/aws"
  version = "~> 6.9"

  identifier = "${var.project_name}-${var.environment}"

  engine               = "mysql"
  engine_version       = var.engine_version
  family               = "mysql${var.engine_version}"
  major_engine_version = var.engine_version
  instance_class       = var.instance_class

  allocated_storage     = var.allocated_storage
  max_allocated_storage = var.allocated_storage * 5
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = "transactions"
  username = "admin"
  port     = 3306

  manage_master_user_password = false
  password                    = random_password.admin.result

  multi_az               = var.multi_az
  publicly_accessible    = false
  create_db_subnet_group = false
  db_subnet_group_name   = data.aws_ssm_parameter.db_subnet_group_name.value
  vpc_security_group_ids = [data.aws_ssm_parameter.db_sg_id.value]

  backup_retention_period = var.backup_retention_period
  deletion_protection     = var.deletion_protection
  skip_final_snapshot     = var.skip_final_snapshot
  apply_immediately       = true

  enabled_cloudwatch_logs_exports = ["error", "slowquery"]
  create_cloudwatch_log_group     = true

  tags = {
    Name = "${var.project_name}-${var.environment}"
  }
}

resource "aws_secretsmanager_secret" "db" {
  name                    = "${var.project_name}/${var.environment}/db"
  description             = "MySQL connection details and credentials for the Expense Tracker"
  recovery_window_in_days = var.secret_recovery_window_days
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id

  secret_string = jsonencode({
    host           = module.db.db_instance_address
    port           = 3306
    dbname         = "transactions"
    admin_username = "admin"
    admin_password = random_password.admin.result
    app_username   = "expense"
    app_password   = random_password.app.result
  })
}
